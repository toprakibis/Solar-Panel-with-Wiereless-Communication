#include <Servo.h>
#include <Wire.h>
#include <LiquidCrystal_I2C.h>

// ===================== NESNELER =====================

Servo servoYatay;
Servo servoDik;

// LCD adresi 0x27 veya 0x3F olabilir.
// Ekran gelmezse 0x27 yerine 0x3F dene.
LiquidCrystal_I2C lcd(0x27, 20, 4);

// ===================== PINLER =====================

// LDR pinleri
const int LDR_SOL = A0;
const int LDR_SAG = A1;
const int LDR_UST = A2;
const int LDR_ALT = A3;

// Servo pinleri
const int SERVO_YATAY_PIN = 5;
const int SERVO_DIK_PIN   = 6;

// ===================== AYARLAR =====================

// Başlangıç açıları
int yatayAci = 90;
int dikAci   = 90;

// Servo hareket sınırları
const int YATAY_MIN = 10;
const int YATAY_MAX = 170;

const int DIK_MIN = 20;
const int DIK_MAX = 160;

// LDR farkı toleransı
// Fark bundan küçükse servo hareket etmez.
int tolerans = 60;

// Her döngüde kaç derece hareket etsin?
int adim = 1;

// LCD yenileme süresi
unsigned long oncekiLcdZamani = 0;
const unsigned long lcdYenilemeSuresi = 500;

// Şimdilik INA219 eklenmediği için geçici değerler
float guc = 0.00;
float verim = 0.00;

// ===================== FONKSİYONLAR =====================

int ldrOrtalamaOku(int pin) {
  long toplam = 0;

  for (int i = 0; i < 10; i++) {
    toplam += analogRead(pin);
    delay(2);
  }

  return toplam / 10;
}

void lcdGuncelle() {
  lcd.clear();

  lcd.setCursor(0, 0);
  lcd.print("Dik Aci   : ");
  lcd.print(dikAci);
  lcd.print((char)223);

  lcd.setCursor(0, 1);
  lcd.print("Yatay Aci : ");
  lcd.print(yatayAci);
  lcd.print((char)223);

  lcd.setCursor(0, 2);
  lcd.print("Guc       : ");
  lcd.print(guc, 2);
  lcd.print(" W");

  lcd.setCursor(0, 3);
  lcd.print("Verim     : %");
  lcd.print(verim, 1);
}

// ===================== SETUP =====================

void setup() {
  Serial.begin(9600);

  servoYatay.attach(SERVO_YATAY_PIN);
  servoDik.attach(SERVO_DIK_PIN);

  servoYatay.write(yatayAci);
  servoDik.write(dikAci);

  lcd.init();
  lcd.backlight();

  lcd.setCursor(0, 0);
  lcd.print("Master Panel");
  lcd.setCursor(0, 1);
  lcd.print("180 Servo Modu");
  delay(1500);
  lcd.clear();

  Serial.println("Master 180 derece servo + LCD basladi.");
}

// ===================== LOOP =====================

void loop() {
  int solDeger = ldrOrtalamaOku(LDR_SOL);
  int sagDeger = ldrOrtalamaOku(LDR_SAG);
  int ustDeger = ldrOrtalamaOku(LDR_UST);
  int altDeger = ldrOrtalamaOku(LDR_ALT);

  int yatayFark = sagDeger - solDeger;
  int dikFark   = ustDeger - altDeger;

  // ===================== YATAY KONTROL =====================
  if (abs(yatayFark) > tolerans) {
    if (yatayFark > 0) {
      // Sag taraf daha aydinliksa yatay aciyi artir
      yatayAci += adim;
    } 
    else {
      // Sol taraf daha aydinliksa yatay aciyi azalt
      yatayAci -= adim;
    }
  }

  // ===================== DIK KONTROL =====================
  if (abs(dikFark) > tolerans) {
    if (dikFark > 0) {
      // Ust taraf daha aydinliksa dik aciyi artir
      dikAci += adim;
    } 
    else {
      // Alt taraf daha aydinliksa dik aciyi azalt
      dikAci -= adim;
    }
  }

  // Servo aci sinirlari
  yatayAci = constrain(yatayAci, YATAY_MIN, YATAY_MAX);
  dikAci   = constrain(dikAci, DIK_MIN, DIK_MAX);

  // Servo konumlarini yaz
  servoYatay.write(yatayAci);
  servoDik.write(dikAci);

  // Serial Monitor kontrol
  Serial.print("Sol: ");
  Serial.print(solDeger);
  Serial.print(" | Sag: ");
  Serial.print(sagDeger);
  Serial.print(" | Ust: ");
  Serial.print(ustDeger);
  Serial.print(" | Alt: ");
  Serial.print(altDeger);

  Serial.print(" || Yatay Fark: ");
  Serial.print(yatayFark);
  Serial.print(" | Dik Fark: ");
  Serial.print(dikFark);

  Serial.print(" || Yatay Aci: ");
  Serial.print(yatayAci);
  Serial.print(" | Dik Aci: ");
  Serial.println(dikAci);

  // LCD guncelleme
  if (millis() - oncekiLcdZamani >= lcdYenilemeSuresi) {
    oncekiLcdZamani = millis();
    lcdGuncelle();
  }

  delay(100);
}
