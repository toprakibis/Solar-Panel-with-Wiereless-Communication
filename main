#include <Servo.h>
#include <Wire.h>
#include <LiquidCrystal_I2C.h>

Servo servoYatay;
Servo servoDik;

// LCD adresi 0x27 veya 0x3F olabilir.
LiquidCrystal_I2C lcd(0x27, 20, 4);

// LDR pinleri
const int LDR_SOL = A0;
const int LDR_SAG = A1;
const int LDR_UST = A2;
const int LDR_ALT = A3;

// Servo pinleri
const int SERVO_YATAY_PIN = 5;
const int SERVO_DIK_PIN   = 6;

// Başlangıç açıları
int yatayAci = 90;
int dikAci   = 90;

// Servo sınırları
const int YATAY_MIN = 10;
const int YATAY_MAX = 170;

const int DIK_MIN = 10;
const int DIK_MAX = 170;

// Takip ayarları
int yatayTolerans = 60;
int dikTolerans   = 60;

// Şimdilik INA219 yok
float guc = 0.00;
float verim = 0.00;

// LCD yenileme
unsigned long oncekiLcdZamani = 0;
const unsigned long lcdYenilemeSuresi = 500;

// LDR ortalama okuma
int ortalamaOku(int pin) {
  long toplam = 0;

  for (int i = 0; i < 10; i++) {
    toplam += analogRead(pin);
    delay(2);
  }

  return toplam / 10;
}

// Farka göre adım hesaplama
int adimHesapla(int fark, int tolerans) {
  int mutlakFark = abs(fark);

  if (mutlakFark <= tolerans) {
    return 0;
  }
  else if (mutlakFark > 200) {
    return 8;
  }
  else if (mutlakFark > 150) {
    return 6;
  }
  else if (mutlakFark > 100) {
    return 4;
  }
  else if (mutlakFark > 60) {
    return 2;
  }
  else if (mutlakFark > 40) {
    return 1;
  }
}

void lcdGuncelle() {
  lcd.setCursor(0, 0);
  lcd.print("Dik Aci   : ");
  lcd.print(dikAci);
  lcd.print((char)223);
  lcd.print("   ");

  lcd.setCursor(0, 1);
  lcd.print("Yatay Aci : ");
  lcd.print(yatayAci);
  lcd.print((char)223);
  lcd.print("   ");

  lcd.setCursor(0, 2);
  lcd.print("Guc       : ");
  lcd.print(guc, 2);
  lcd.print(" W   ");

  lcd.setCursor(0, 3);
  lcd.print("Verim     : %");
  lcd.print(verim, 1);
  lcd.print("   ");
}

void setup() {
  Serial.begin(9600);

  servoYatay.attach(SERVO_YATAY_PIN);
  servoDik.attach(SERVO_DIK_PIN);

  servoYatay.write(yatayAci);
  servoDik.write(dikAci);

  lcd.init();
  lcd.backlight();

  lcd.setCursor(0, 0);
  lcd.print("Master Panel");
  lcd.setCursor(0, 1);
  lcd.print("Adaptif Takip");
  delay(1500);
  lcd.clear();

  Serial.println("Master + Adaptif Servo Takip basladi.");
}

void loop() {
  int sol = ortalamaOku(LDR_SOL);
  int sag = ortalamaOku(LDR_SAG);
  int ust = ortalamaOku(LDR_UST);
  int alt = ortalamaOku(LDR_ALT);

  int yatayFark = sag - sol;
  int dikFark   = ust - alt;

  int yatayAdim = adimHesapla(yatayFark, yatayTolerans);
  int dikAdim   = adimHesapla(dikFark, dikTolerans);

  // YATAY KONTROL
  if (yatayAdim > 0) {
    if (yatayFark > 0) {
      yatayAci += yatayAdim;
    } else {
      yatayAci -= yatayAdim;
    }
  }

  // DIKEY KONTROL
  if (dikAdim > 0) {
    if (dikFark > 0) {
      dikAci += dikAdim;
    } else {
      dikAci -= dikAdim;
    }
  }

  yatayAci = constrain(yatayAci, YATAY_MIN, YATAY_MAX);
  dikAci   = constrain(dikAci, DIK_MIN, DIK_MAX);

  servoYatay.write(yatayAci);
  servoDik.write(dikAci);

  Serial.print("Sol: ");
  Serial.print(sol);
  Serial.print(" | Sag: ");
  Serial.print(sag);
  Serial.print(" | Ust: ");
  Serial.print(ust);
  Serial.print(" | Alt: ");
  Serial.print(alt);

  Serial.print(" || YatayFark: ");
  Serial.print(yatayFark);
  Serial.print(" | DikFark: ");
  Serial.print(dikFark);

  Serial.print(" || YatayAdim: ");
  Serial.print(yatayAdim);
  Serial.print(" | DikAdim: ");
  Serial.print(dikAdim);

  Serial.print(" || YatayAci: ");
  Serial.print(yatayAci);
  Serial.print(" | DikAci: ");
  Serial.println(dikAci);

  if (millis() - oncekiLcdZamani >= lcdYenilemeSuresi) {
    oncekiLcdZamani = millis();
    lcdGuncelle();
  }

  delay(150);
}
